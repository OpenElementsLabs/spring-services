# Local release credentials — copy this file to .env and fill in values.
# .env is gitignored and must never be committed.

# GitHub personal access token (for creating GitHub Releases)
JRELEASER_GITHUB_TOKEN=

# Maven Central portal credentials (https://central.sonatype.com)
JRELEASER_MAVENCENTRAL_USERNAME=
JRELEASER_MAVENCENTRAL_TOKEN=

# GPG signing key (armored private key and its passphrase)
JRELEASER_GPG_PASSPHRASE=
JRELEASER_GPG_SECRET_KEY=
JRELEASER_GPG_PUBLIC_KEY=
